# AegisTrade AI - WEEX Futures V3 Configuration

WEEX_BASE_URL=https://api-contract.weex.com

# Keep these values ONLY in your local backend .env file.
# Never put them in App.jsx, frontend code, GitHub, or screenshots.
WEEX_API_KEY=
WEEX_SECRET_KEY=
WEEX_PASSPHRASE=

# Day 6A testing: keep false.
# false = order payload is validated/prepared but never sent
# true  = real WEEX order submission is allowed after testing
WEEX_LIVE_TRADING=false

# Additional live-order safety cap. A live order whose estimated
# quantity x entry price exceeds this amount is blocked by the backend.
WEEX_MAX_LIVE_ORDER_NOTIONAL_USDT=100

# Local development defaults. For deployment, replace with your deployed frontend URL.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
