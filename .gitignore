.env
.env.*
!.env.example

# Python
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Node
node_modules/
dist/
dist-ssr/
.vite/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
"@